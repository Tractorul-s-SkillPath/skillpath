# SkillPath environment template.
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never contain a real value.

# Supabase dashboard -> Project Settings -> API Keys.
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable (anon) key: sb_publishable_... or a JWT starting eyJ...
#
# This is public by design and ships to the browser. Normally Row Level
# Security is what protects the data behind it — this project has RLS disabled,
# so anybody holding this key can read and write every table directly. Bear
# that in mind before pointing it at anything real.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs the session cookie. Any 32+ random characters; changing it signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# ---------------------------------------------------------------------------
# .env.e2e — the end-to-end run (SP-101). A SEPARATE FILE, not this one.
# ---------------------------------------------------------------------------
#
# `npm run test:e2e` registers members, grades papers and writes plan rows, so
# it needs a Supabase project of its own. The three names above again, with the
# TEST project's values:
#
#   NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   SESSION_SECRET=
#
# e2e/helpers/env.ts compares that URL against .env.local and refuses to run if
# they match. Seed the project once with `npm run seed:e2e`; the baseline needs
# its twenty questions or no run can open.
#
# In CI there is no file — the same three names come from repository secrets.


