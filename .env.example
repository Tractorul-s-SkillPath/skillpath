# SkillPath environment — SP-001
# Copy to .env.local and fill. Every value here stays EMPTY in git.

# Public — safe in the browser bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefixed NEXT_PUBLIC_, never imported outside lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# mock | anthropic   (mock is the default in tests and CI — SP-090)
AI_PROVIDER=mock
